{
  "expo": {
    "name": "Shark Gym",
    "slug": "login_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-custom.png",
    "scheme": "loginapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.jrdamn.sharkgym",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#060709",
        "foregroundImage": "./assets/images/logo-custom.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#208AEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76ccbf1b-d1bc-45c8-9b78-a1167b2d3148"
      }
    },
    "owner": "jordamn"
  }
}
